---
import type { Guide } from '../data/guides';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import { buildBookingUrl } from '../config/site';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const home = localizedPath('/', locale);
const bookingUrl = buildBookingUrl({ locale });
---

<article>
  <!-- Hero -->
  <header class="relative min-h-[62vh] flex items-end overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        src={guide.hero.image}
        alt={guide.hero.alt[locale]}
        class="h-full w-full object-cover"
        fetchpriority="high"
        onerror={`this.onerror=null;this.src='${guide.hero.fallback}'`}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-sea-950/85 via-sea-950/35 to-sea-950/30"></div>
    </div>
    <div class="container-page pb-12 pt-36 text-white">
      <a href={`${home}#destino`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-white/80 hover:text-white">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
        {t('guide.back')}
      </a>
      <h1 class="mt-4 max-w-3xl font-display font-semibold text-3xl sm:text-5xl leading-tight tracking-tight">
        {guide.title[locale]}
      </h1>
    </div>
  </header>

  <!-- Intro -->
  <div class="container-page">
    <p class="max-w-3xl mx-auto py-12 sm:py-16 text-lg sm:text-xl leading-relaxed text-sea-950/75 text-center font-medium">
      {guide.intro[locale]}
    </p>
  </div>

  <!-- Secciones alternadas -->
  <div class="container-page space-y-16 sm:space-y-24 pb-16">
    {
      guide.sections.map((s, i) => (
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center reveal">
          <div class:list={['overflow-hidden rounded-3xl shadow-md ring-1 ring-sea-950/5', i % 2 === 1 && 'lg:order-2']}>
            {s.image && (
              <img
                src={s.image}
                alt={s.imageAlt[locale]}
                loading="lazy"
                class="w-full aspect-[4/3] object-cover"
                onerror={`this.onerror=null;this.src='${s.fallback ?? '/images/beach.svg'}'`}
              />
            )}
          </div>
          <div class:list={[i % 2 === 1 && 'lg:order-1']}>
            <h2 class="font-display font-semibold text-2xl sm:text-3xl text-sea-950 leading-tight">
              {s.title[locale]}
            </h2>
            <p class="mt-4 text-sea-950/70 leading-relaxed text-lg">{s.text[locale]}</p>
            {s.link && (
              <a
                href={s.link.url}
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-2 rounded-full bg-sea-900 hover:bg-sea-700 text-white text-sm font-semibold px-5 py-2.5 transition-colors"
              >
                {s.link.label[locale]}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
            )}
            {s.creditUrl && (
              <a href={s.creditUrl} target="_blank" rel="noopener" class="mt-3 inline-block text-xs text-sea-950/40 hover:text-sea-700 underline">
                {t('guide.photo')}
              </a>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <!-- CTA -->
  <section class="bg-sea-950 text-white">
    <div class="container-page py-16 text-center">
      <h2 class="font-display font-semibold text-2xl sm:text-4xl max-w-2xl mx-auto leading-tight">
        {guide.cta[locale]}
      </h2>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex justify-center items-center gap-2 rounded-full bg-sunset-500 hover:bg-sunset-600 text-white font-semibold px-7 py-3.5 transition-colors"
        >
          {t('guide.ctaBook')}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a
          href={`${home}#apartamentos`}
          class="inline-flex justify-center items-center rounded-full bg-white/10 hover:bg-white/20 ring-1 ring-white/25 text-white font-semibold px-7 py-3.5 transition-colors"
        >
          {t('guide.ctaApartments')}
        </a>
      </div>
      <p class="mt-10 text-xs text-white/35">{t('guide.credits')}</p>
    </div>
  </section>
</article>
