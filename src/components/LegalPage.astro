---
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  title: string;
}
const { title } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<article class="pt-28 pb-20 min-h-[60vh]">
  <div class="container-page max-w-3xl">
    <h1 class="font-display font-semibold text-3xl sm:text-4xl text-sea-950">{title}</h1>
    <p class="mt-6 text-sea-950/70 leading-relaxed">{t('legal.placeholder')}</p>
    <div class="mt-8 rounded-xl bg-sand-50 ring-1 ring-sea-950/5 p-5 text-sm text-sea-950/60">
      <slot />
    </div>
  </div>
</article>
