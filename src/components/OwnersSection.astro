---
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';
import OwnersWizard from './OwnersWizard.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const benefits = ['income', 'hassle', 'channels', 'care'];
---

<section id="propietarios" class="py-20 sm:py-24 scroll-mt-24">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Texto + beneficios -->
      <div class="reveal">
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-sunset-600">
          <span class="h-px w-6 bg-current opacity-50"></span>
          {t('owners.eyebrow')}
        </p>
        <h2 class="mt-3 font-display font-semibold text-3xl sm:text-4xl leading-tight text-sea-950">
          {t('owners.title')}
        </h2>
        <p class="mt-4 text-lg text-sea-950/65 leading-relaxed">{t('owners.subtitle')}</p>

        <ul class="mt-7 space-y-3">
          {
            benefits.map((b) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 grid place-items-center h-6 w-6 rounded-full bg-sea-100 text-sea-700">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                </span>
                <span class="text-sea-950/80">{t(`owners.benefits.${b}`)}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Asistente conversacional -->
      <div class="reveal">
        <OwnersWizard />
      </div>
    </div>
  </div>
</section>
