---
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';
import { site } from '../config/site';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const benefits = ['income', 'hassle', 'channels', 'care'];
const mailto = `mailto:${site.contact.email}?subject=${encodeURIComponent('Gestión de vivienda - Rentalsur La Línea')}`;
---

<section id="propietarios" class="py-20 sm:py-24 scroll-mt-24">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Texto + beneficios -->
      <div class="reveal">
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-sunset-600">
          <span class="h-px w-6 bg-current opacity-50"></span>
          {t('owners.eyebrow')}
        </p>
        <h2 class="mt-3 font-display font-semibold text-3xl sm:text-4xl leading-tight text-sea-950">
          {t('owners.title')}
        </h2>
        <p class="mt-4 text-lg text-sea-950/65 leading-relaxed">{t('owners.subtitle')}</p>

        <ul class="mt-7 space-y-3">
          {
            benefits.map((b) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 shrink-0 grid place-items-center h-6 w-6 rounded-full bg-sea-100 text-sea-700">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                </span>
                <span class="text-sea-950/80">{t(`owners.benefits.${b}`)}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Formulario -->
      <div class="reveal rounded-3xl bg-sand-50 ring-1 ring-sea-950/5 p-6 sm:p-8 shadow-sm">
        <form
          name="propietarios"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action={mailto}
          data-ajax-form
          data-mailto={mailto}
          data-success={t('owners.formSuccess')}
          class="space-y-4"
        >
          <input type="hidden" name="form-name" value="propietarios" />
          <p class="hidden">
            <label>No rellenar: <input name="bot-field" /></label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="block text-sm font-medium text-sea-950/70 mb-1.5">{t('owners.formName')}</span>
              <input name="nombre" type="text" required class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400" />
            </label>
            <label class="block">
              <span class="block text-sm font-medium text-sea-950/70 mb-1.5">{t('owners.formPhone')}</span>
              <input name="telefono" type="tel" class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400" />
            </label>
          </div>
          <label class="block">
            <span class="block text-sm font-medium text-sea-950/70 mb-1.5">{t('owners.formEmail')}</span>
            <input name="email" type="email" required class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400" />
          </label>
          <label class="block">
            <span class="block text-sm font-medium text-sea-950/70 mb-1.5">{t('owners.formMessage')}</span>
            <textarea name="mensaje" rows="4" class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400"></textarea>
          </label>

          <button type="submit" class="w-full inline-flex justify-center items-center rounded-full bg-sea-600 hover:bg-sea-700 text-white font-semibold px-5 py-3 transition-colors">
            {t('owners.formSend')}
          </button>
          <p class="text-sm font-medium text-sea-700 hidden" data-success-msg></p>
        </form>
      </div>
    </div>
  </div>
</section>
