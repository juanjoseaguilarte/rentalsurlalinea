---
import type { Property } from '../data/properties';
import { propertyBookingUrl } from '../data/properties';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import { whatsappLink, site } from '../config/site';

interface Props {
  property: Property;
}
const { property } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const backHref = localizedPath('/', locale) + '#apartamentos';
const bookUrl = propertyBookingUrl(property, locale);
const wa = whatsappLink(
  locale === 'es'
    ? `¡Hola! Me interesa "${property.name}". ¿Está disponible?`
    : `Hi! I'm interested in "${property.name}". Is it available?`
);
---

<article class="pt-28 pb-20">
  <div class="container-page">
    <a href={backHref} class="inline-flex items-center gap-1.5 text-sm font-medium text-sea-700 hover:text-sea-900">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
      {t('apartmentPage.backToAll')}
    </a>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Imagen -->
      <div class="overflow-hidden rounded-3xl shadow-sm ring-1 ring-sea-950/5">
        <img src={property.image} alt={property.name} class="w-full h-full object-cover aspect-[4/3]" />
      </div>

      <!-- Info -->
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sea-50 text-sea-700 text-sm font-semibold px-3 py-1">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {property.area[locale]}
        </span>
        <h1 class="mt-4 font-display font-semibold text-3xl sm:text-4xl text-sea-950 leading-tight">{property.name}</h1>

        <div class="mt-5 flex flex-wrap gap-5 text-sea-950/75">
          <span class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>{property.guests} {t('apartments.guests')}</span>
          <span class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 11h20M4 11V7a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2M2 17h20M4 21v-4M20 21v-4"/></svg>{property.bedrooms} {t('apartments.bedrooms')}</span>
          <span class="inline-flex items-center gap-2"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h16M6 12V5a2 2 0 0 1 2-2 2 2 0 0 1 2 2M4 12v4a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4v-4"/></svg>{property.bathrooms}</span>
        </div>

        <h2 class="mt-8 font-display font-semibold text-xl text-sea-950">{t('apartmentPage.aboutTitle')}</h2>
        <p class="mt-3 text-sea-950/70 leading-relaxed">{property.description[locale]}</p>

        <h2 class="mt-8 font-display font-semibold text-xl text-sea-950">{t('apartmentPage.features')}</h2>
        <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {
            property.features[locale].map((f) => (
              <li class="flex items-center gap-2.5 text-sea-950/80">
                <span class="grid place-items-center h-5 w-5 rounded-full bg-sea-100 text-sea-700 shrink-0">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                </span>
                {f}
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a href={bookUrl} target="_blank" rel="noopener" class="flex-1 inline-flex justify-center items-center gap-2 rounded-full bg-sunset-500 hover:bg-sunset-600 text-white font-semibold px-6 py-3.5 transition-colors">
            {t('apartmentPage.bookNow')}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={wa} target="_blank" rel="noopener" class="inline-flex justify-center items-center gap-2 rounded-full bg-white ring-1 ring-sea-200 text-sea-800 hover:bg-sea-50 font-semibold px-6 py-3.5 transition-colors">
            {t('apartmentPage.askWhatsapp')}
          </a>
        </div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Apartment',
    name: property.name,
    description: property.description[locale],
    occupancy: { '@type': 'QuantitativeValue', maxValue: property.guests },
    numberOfBedrooms: property.bedrooms,
    numberOfBathroomsTotal: property.bathrooms,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'La Línea de la Concepción',
      addressRegion: 'Cádiz',
      addressCountry: 'ES',
    },
    image: new URL(property.image, site.url).toString(),
  })} />
</article>
