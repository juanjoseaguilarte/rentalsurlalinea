---
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';
import { site, bookingHomeUrl } from '../config/site';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const { baseUrl, searchPath, dateFormat } = site.booking;
const searchUrl = new URL(searchPath, baseUrl).toString();
const fallbackUrl = bookingHomeUrl(locale);
---

<form
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto_auto] gap-3 items-end"
  data-search-form
  data-search-url={searchUrl}
  data-fallback-url={fallbackUrl}
  data-date-format={dateFormat}
  data-locale={locale}
>
  <label class="block">
    <span class="block text-xs font-semibold uppercase tracking-wide text-sea-950/60 mb-1.5"
      >{t('hero.checkin')}</span
    >
    <input
      type="date"
      name="checkin"
      class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-3 text-sea-950 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400"
    />
  </label>

  <label class="block">
    <span class="block text-xs font-semibold uppercase tracking-wide text-sea-950/60 mb-1.5"
      >{t('hero.checkout')}</span
    >
    <input
      type="date"
      name="checkout"
      class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-3 text-sea-950 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400"
    />
  </label>

  <label class="block">
    <span class="block text-xs font-semibold uppercase tracking-wide text-sea-950/60 mb-1.5"
      >{t('hero.guests')}</span
    >
    <select
      name="guests"
      class="w-full rounded-xl border border-sea-200 bg-white px-3.5 py-3 text-sea-950 focus:outline-none focus:ring-2 focus:ring-sea-400 focus:border-sea-400"
    >
      {
        [1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
          <option value={n} selected={n === 2}>
            {n} {n === 1 ? t('hero.guest_one') : t('hero.guest_other')}
          </option>
        ))
      }
    </select>
  </label>

  <button
    type="submit"
    class="h-[50px] inline-flex items-center justify-center gap-2 rounded-xl bg-sea-900 hover:bg-sea-700 text-white font-semibold px-5 transition-colors whitespace-nowrap"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    {t('hero.search')}
  </button>
</form>

<script>
  // Construye la URL /book/step1 del motor Kross (mismo formato que rentalbenidorm)
  // y la abre en pestaña nueva. Fallback seguro: sin fechas → listado de alojamientos.
  document.querySelectorAll('[data-search-form]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fallback = form.dataset.fallbackUrl || '';
      try {
        const data = new FormData(form);
        const checkin = data.get('checkin')?.toString() ?? '';
        const checkout = data.get('checkout')?.toString() ?? '';
        const guests = Number(data.get('guests')) || 2;
        if (!checkin && !checkout) {
          window.open(fallback, '_blank', 'noopener');
          return;
        }
        const fmt = (iso: string) => {
          if (!iso) return '';
          if (form.dataset.dateFormat === 'YYYY-MM-DD') return iso;
          const [y, m, d] = iso.split('-');
          return `${d}/${m}/${y}`;
        };
        const url = new URL(form.dataset.searchUrl || fallback);
        url.searchParams.set('adults', String(guests));
        url.searchParams.set('children', '0');
        url.searchParams.set('rooms', '1');
        url.searchParams.set('guests', String(guests));
        url.searchParams.set('n_guests', String(guests));
        url.searchParams.set('guests_rooms', `${guests},0;`);
        url.searchParams.set('kross_lang', form.dataset.locale || 'es');
        url.searchParams.set('from', fmt(checkin));
        url.searchParams.set('to', fmt(checkout));
        window.open(url.toString(), '_blank', 'noopener');
      } catch {
        window.open(fallback, '_blank', 'noopener');
      }
    });
  });
</script>
