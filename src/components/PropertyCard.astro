---
import type { Property } from '../data/properties';
import { propertyBookingUrl } from '../data/properties';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/ui';

interface Props {
  property: Property;
}
const { property } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const detailsPath =
  locale === 'es'
    ? localizedPath(`/apartamentos/${property.slug}`, 'es')
    : localizedPath(`/apartments/${property.slug}`, 'en');
const bookUrl = propertyBookingUrl(property, locale);
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-sea-950/5 shadow-sm hover:shadow-xl transition-shadow duration-300 reveal"
>
  <a href={detailsPath} class="relative block aspect-[4/3] overflow-hidden">
    <img
      src={property.image}
      alt={property.name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span
      class="absolute top-3 left-3 rounded-full bg-white/90 backdrop-blur px-3 py-1 text-xs font-semibold text-sea-800"
      >{property.area[locale]}</span
    >
    {property.pending && (
      <span class="absolute bottom-3 left-3 rounded-full bg-sea-950/70 backdrop-blur px-3 py-1 text-xs font-semibold text-white"
        >{t('apartments.pendingPhotos')}</span>
    )}
  </a>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display font-semibold text-lg text-sea-950 leading-snug">
      <a href={detailsPath} class="hover:text-sea-700 transition-colors">{property.name}</a>
    </h3>
    <p class="mt-1.5 text-sm text-sea-950/65 leading-relaxed">{property.short[locale]}</p>

    {(property.guests || property.bedrooms) && (
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-sea-950/70">
        {property.guests && (
          <li class="inline-flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
            {property.guests} {t('apartments.guests')}
          </li>
        )}
        {property.bedrooms && (
          <li class="inline-flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 11h20M4 11V7a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2M2 17h20M4 21v-4M20 21v-4"/></svg>
            {property.bedrooms} {t('apartments.bedrooms')}
          </li>
        )}
      </ul>
    )}

    <div class="mt-5 pt-4 border-t border-sea-950/5 flex items-center gap-3">
      <a
        href={bookUrl}
        target="_blank"
        rel="noopener"
        class="flex-1 inline-flex justify-center items-center rounded-full bg-sunset-500 hover:bg-sunset-600 text-white text-sm font-semibold px-4 py-2.5 transition-colors"
        >{t('apartments.book')}</a
      >
      <a
        href={detailsPath}
        class="inline-flex justify-center items-center rounded-full text-sm font-semibold text-sea-700 hover:text-sea-900 px-3 py-2.5"
        >{t('apartments.details')}</a
      >
    </div>
  </div>
</article>
