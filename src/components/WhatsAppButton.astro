---
import { getLocaleFromUrl } from '../i18n/ui';
import { whatsappLink } from '../config/site';

const locale = getLocaleFromUrl(Astro.url);
const label = locale === 'es' ? 'Escríbenos por WhatsApp' : 'Message us on WhatsApp';
const wa = whatsappLink(locale === 'es' ? '¡Hola! Me gustaría más información.' : 'Hi! I would like more information.');
---

<a
  href={wa}
  target="_blank"
  rel="noopener"
  aria-label={label}
  class="fixed bottom-5 right-5 z-40 group inline-flex items-center gap-2 rounded-full bg-[#25D366] hover:bg-[#1ebe5b] text-white shadow-lg shadow-black/20 transition-all h-14 pl-4 pr-4 sm:pr-5"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.26-.1-.45-.15-.65.15s-.74.94-.9 1.13c-.17.2-.34.22-.63.08a8.2 8.2 0 0 1-2.4-1.5 9 9 0 0 1-1.66-2.06c-.17-.3 0-.46.13-.6.13-.14.3-.34.44-.5.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.65-1.57-.9-2.15-.23-.56-.47-.48-.64-.49h-.55c-.2 0-.5.07-.77.37-.26.3-1 .98-1 2.4s1.03 2.78 1.17 2.97c.15.2 2.03 3.1 4.92 4.35.69.3 1.22.47 1.64.6.69.22 1.31.19 1.8.12.56-.09 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.2-.55-.34ZM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Z"/></svg>
  <span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-semibold opacity-0 group-hover:max-w-[220px] group-hover:opacity-100 transition-all duration-300">{label}</span>
</a>
