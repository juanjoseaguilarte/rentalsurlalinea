---
import { properties } from '../data/properties';
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';
import { buildBookingUrl } from '../config/site';
import PropertyCard from './PropertyCard.astro';
import SectionHeading from './SectionHeading.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const viewAllUrl = buildBookingUrl({ locale });
---

<section id="apartamentos" class="py-20 sm:py-24 bg-sand-50 scroll-mt-24">
  <div class="container-page">
    <SectionHeading
      eyebrow={t('apartments.eyebrow')}
      title={t('apartments.title')}
      subtitle={t('apartments.subtitle')}
    />

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {properties.map((property) => <PropertyCard property={property} />)}
    </div>

    <div class="mt-10 flex flex-col items-center gap-3">
      <a
        href={viewAllUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-sea-600 hover:bg-sea-700 text-white font-semibold px-6 py-3 shadow-sm transition-colors"
      >
        {t('apartments.viewAll')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <p class="text-xs text-sea-950/45 italic">{t('apartments.placeholderNote')}</p>
    </div>
  </div>
</section>
