---
import { getLocaleFromUrl, useTranslations } from '../i18n/ui';
import { buildBookingUrl } from '../config/site';
import SectionHeading from './SectionHeading.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const bookingUrl = buildBookingUrl({ locale });

const points = [
  { key: 'price', icon: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' },
  { key: 'trust', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>' },
  { key: 'flex', icon: '<path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/>' },
];
---

<section class="py-20 sm:py-24 bg-sea-950 text-white relative overflow-hidden">
  <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sea-700/40 blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-sunset-600/20 blur-3xl"></div>

  <div class="container-page relative">
    <SectionHeading eyebrow={t('why.eyebrow')} title={t('why.title')} light />

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        points.map((p) => (
          <div class="reveal rounded-2xl bg-white/5 ring-1 ring-white/10 p-6 backdrop-blur">
            <span class="grid place-items-center h-12 w-12 rounded-xl bg-sunset-500/20 text-sunset-300 mb-4">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <h3 class="font-display font-semibold text-lg">{t(`why.points.${p.key}.title`)}</h3>
            <p class="mt-2 text-sm text-white/70 leading-relaxed">{t(`why.points.${p.key}.desc`)}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center reveal">
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-sunset-500 hover:bg-sunset-600 text-white font-semibold px-7 py-3.5 shadow-lg transition-colors"
      >
        {t('nav.book')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>
