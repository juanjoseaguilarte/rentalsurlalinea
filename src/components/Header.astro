---
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import { buildBookingUrl } from '../config/site';
import LangSwitch from './LangSwitch.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const home = localizedPath('/', locale);
const bookingUrl = buildBookingUrl({ locale });

const navItems = [
  { href: `${home}#apartamentos`, label: t('nav.apartments') },
  { href: `${home}#servicios`, label: t('nav.services') },
  { href: `${home}#destino`, label: t('nav.destination') },
  { href: `${home}#propietarios`, label: t('nav.owners') },
  { href: `${home}#contacto`, label: t('nav.contact') },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
  data-header
>
  <div class="container-page">
    <div
      class="mt-3 flex items-center justify-between rounded-2xl bg-white/85 backdrop-blur-md shadow-sm ring-1 ring-sea-950/5 px-4 sm:px-5 h-14"
    >
      <!-- Logo -->
      <a href={home} class="flex items-center gap-2 group" aria-label="Rentalsur La Línea">
        <span
          class="grid place-items-center h-9 w-9 rounded-xl bg-sea-600 text-white font-display font-semibold text-lg group-hover:bg-sea-700 transition-colors"
          >R</span
        >
        <span class="font-display font-semibold text-sea-950 leading-tight text-[15px]">
          Rentalsur<span class="text-sunset-600">.</span><br class="hidden sm:block" />
          <span class="text-sea-950/60 text-xs font-sans font-medium tracking-wide">LA LÍNEA</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Principal">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-sea-950/75 hover:text-sea-700 rounded-lg transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="hidden sm:block"><LangSwitch /></div>
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener"
          class="hidden sm:inline-flex items-center rounded-full bg-sunset-500 hover:bg-sunset-600 text-white text-sm font-semibold px-4 py-2 shadow-sm transition-colors"
        >
          {t('nav.book')}
        </a>

        <!-- Mobile toggle -->
        <button
          type="button"
          class="lg:hidden grid place-items-center h-10 w-10 rounded-lg text-sea-950 hover:bg-sea-50 transition-colors"
          aria-label="Menú"
          aria-expanded="false"
          data-menu-toggle
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    class="lg:hidden hidden container-page"
    data-mobile-menu
  >
    <nav
      class="mt-2 rounded-2xl bg-white shadow-lg ring-1 ring-sea-950/5 p-3 flex flex-col gap-1"
      aria-label="Menú móvil"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2.5 text-base font-medium text-sea-950/80 hover:bg-sea-50 rounded-lg transition-colors"
            data-menu-link
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener"
        class="mt-1 inline-flex justify-center items-center rounded-full bg-sunset-500 hover:bg-sunset-600 text-white text-base font-semibold px-4 py-2.5 transition-colors"
      >
        {t('nav.book')}
      </a>
      <div class="pt-2 flex justify-center"><LangSwitch /></div>
    </nav>
  </div>
</header>

<script>
  // Header: fondo sólido al hacer scroll + toggle menú móvil
  const header = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 20) header?.classList.add('scrolled');
    else header?.classList.remove('scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('[data-menu-link]').forEach((l) =>
    l.addEventListener('click', () => {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>

<style>
  [data-header].scrolled > .container-page > div {
    background-color: rgba(255, 255, 255, 0.95);
  }
</style>
