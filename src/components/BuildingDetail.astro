---
import type { Building } from '../data/buildings';
import { buildingUnits } from '../data/buildings';
import { getLocaleFromUrl, useTranslations, localizedPath } from '../i18n/ui';
import { bookingHomeUrl, site } from '../config/site';
import PropertyCard from './PropertyCard.astro';

interface Props {
  building: Building;
}
const { building } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const backHref = localizedPath('/', locale) + '#apartamentos';
const bookUrl = bookingHomeUrl(locale);
const units = buildingUnits(building.slug);
const badge = t('building.badge').replace('{n}', String(building.unitCount));
---

<article class="pt-28 pb-20">
  <div class="container-page">
    <a href={backHref} class="inline-flex items-center gap-1.5 text-sm font-medium text-sea-700 hover:text-sea-900">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
      {t('apartmentPage.backToAll')}
    </a>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div class="overflow-hidden rounded-3xl shadow-sm ring-1 ring-sea-950/5">
        <img src={building.image} alt={building.name} class="w-full h-full object-cover aspect-[4/3]" />
      </div>
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-sea-50 text-sea-700 text-sm font-semibold px-3 py-1">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1"/></svg>
          {badge}
        </span>
        <h1 class="mt-4 font-display font-semibold text-3xl sm:text-4xl text-sea-950 leading-tight">
          {building.name}
        </h1>
        <p class="mt-4 text-sea-950/70 leading-relaxed text-lg">{building.description[locale]}</p>
        <a
          href={bookUrl}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-sunset-500 hover:bg-sunset-600 text-white font-semibold px-6 py-3.5 transition-colors"
        >
          {t('apartmentPage.bookNow')}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <!-- Unidades -->
    <h2 class="mt-16 font-display font-semibold text-2xl text-sea-950">{t('building.units')}</h2>
    {
      units.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {units.map((property) => (
            <PropertyCard property={property} />
          ))}
        </div>
      ) : (
        <p class="mt-4 max-w-2xl text-sea-950/60 leading-relaxed">{t('building.unitsPending')}</p>
      )
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ApartmentComplex',
    name: building.name,
    description: building.description[locale],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'La Línea de la Concepción',
      addressRegion: 'Cádiz',
      addressCountry: 'ES',
    },
    numberOfAccommodationUnits: { '@type': 'QuantitativeValue', value: building.unitCount },
    image: building.image,
    url: new URL(Astro.url.pathname, site.url).toString(),
  })} />
</article>
