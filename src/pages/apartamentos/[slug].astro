---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApartmentDetail from '../../components/ApartmentDetail.astro';
import BuildingDetail from '../../components/BuildingDetail.astro';
import { properties, type Property } from '../../data/properties';
import { buildings, type Building } from '../../data/buildings';

export function getStaticPaths() {
  return [
    ...properties.map((property) => ({
      params: { slug: property.slug },
      props: { property, building: undefined as Building | undefined },
    })),
    ...buildings.map((building) => ({
      params: { slug: building.slug },
      props: { property: undefined as Property | undefined, building },
    })),
  ];
}

const { property, building } = Astro.props;

// Título SEO: nombre exacto del anuncio; en unidades, también el edificio.
const title = building
  ? `${building.name} | Rentalsur La Línea`
  : `${property!.name}${property!.building && property!.building !== property!.name ? ` · ${property!.building}` : ''} | Rentalsur La Línea`;
const description = building ? building.short.es : property!.short.es;
const image = building ? building.image : property!.image;
---

<BaseLayout title={title} description={description} image={image}>
  {building ? <BuildingDetail building={building} /> : <ApartmentDetail property={property!} />}
</BaseLayout>
