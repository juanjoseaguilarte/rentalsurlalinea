---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePage from '../../components/GuidePage.astro';
import { guides } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
---

<BaseLayout
  title={`${guide.title.es} | Rentalsur La Línea`}
  description={guide.metaDescription.es}
  image={guide.hero.image}
>
  <GuidePage guide={guide} />
</BaseLayout>
