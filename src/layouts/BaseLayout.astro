---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { getLocaleFromUrl, useTranslations, alternatePath } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Ruta canónica de la página (sin dominio), p. ej. "/apartamentos/xxx". */
  path?: string;
  image?: string;
  /** true = pedir a los buscadores que no indexen la página (p. ej. 404). */
  noindex?: boolean;
}

const { title, description, image = '/images/hero.svg', noindex = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = title ?? t('meta.title');
const pageDesc = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();

// hreflang alternates
const esHref = new URL(alternatePath(Astro.url, 'es'), site.url).toString();
const enHref = new URL(alternatePath(Astro.url, 'en'), site.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: pageDesc,
  url: site.url,
  email: site.contact.email,
  telephone: site.contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle Moreno de Mora, 40',
    postalCode: '11300',
    addressLocality: 'La Línea de la Concepción',
    addressRegion: 'Cádiz',
    addressCountry: 'ES',
  },
  areaServed: 'La Línea de la Concepción, Cádiz',
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main id="inicio">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <!-- Reveal on scroll (progresivo, respeta reduced-motion) -->
    <script>
      const els = document.querySelectorAll('.reveal');
      const revealAll = () => els.forEach((el) => el.classList.add('is-visible'));
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
        // Red de seguridad: nada queda oculto permanentemente
        window.addEventListener('load', () => setTimeout(revealAll, 2500));
      } else {
        revealAll();
      }
    </script>

    <!-- Envío de formularios: FormSubmit (AJAX → email) con fallback a mailto -->
    <script>
      document.querySelectorAll('[data-ajax-form]').forEach((el) => {
        const form = el as HTMLFormElement;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const data = new FormData(form);
          const successEl = form.querySelector('[data-success-msg]') as HTMLElement | null;
          const successText = form.dataset.success || '¡Gracias!';
          const mailto = form.dataset.mailto || '';
          try {
            const endpoint = form.dataset.endpoint;
            if (!endpoint) throw new Error('no-endpoint');
            const payload: Record<string, string> = {
              _subject: form.dataset.subject || 'Nuevo mensaje - Rentalsur La Línea',
              _template: 'table',
              _captcha: 'false',
            };
            data.forEach((v, k) => {
              if (!k.startsWith('_') && k !== 'bot-field' && k !== 'form-name') payload[k] = String(v);
            });
            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error('not-ok');
            form.reset();
            if (successEl) {
              successEl.textContent = successText;
              successEl.classList.remove('hidden');
            }
          } catch {
            // Fallback (p. ej. hosting sin Netlify Forms): abrir cliente de correo
            const nombre = (data.get('nombre') || '').toString();
            const email = (data.get('email') || '').toString();
            const mensaje = (data.get('mensaje') || '').toString();
            const telefono = (data.get('telefono') || '').toString();
            const body = [
              nombre && `Nombre: ${nombre}`,
              email && `Email: ${email}`,
              telefono && `Teléfono: ${telefono}`,
              mensaje && `\n${mensaje}`,
            ]
              .filter(Boolean)
              .join('\n');
            const url = mailto + (mailto.includes('?') ? '&' : '?') + 'body=' + encodeURIComponent(body);
            window.location.href = url;
          }
        });
      });
    </script>
  </body>
</html>
